# Flask
FLASK_ENV=production
SECRET_KEY=change-me

# Local backend fallback database
# Docker backend will override this with PostgreSQL via docker-compose.yml
DATABASE_URL=sqlite:////data/tourism.db

# Docker PostgreSQL / Redis settings
DB_USER=tourism
DB_PASSWORD=change-me
DB_NAME=tourism
REDIS_PASSWORD=change-me
SERVER_IP=your-domain-or-ip

# Admin bootstrap user
ADMIN_EMAIL=admin@tourism.com
ADMIN_PASSWORD=change-me

# Optional integrations
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# Set True only when serving behind HTTPS
SESSION_COOKIE_SECURE=False

FRONTEND_NGINX_CONF=nginx.local.conf
LETSENCRYPT_PATH=./frontend/dev-certs
